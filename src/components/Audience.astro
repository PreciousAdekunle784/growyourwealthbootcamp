---
import Folio from './Folio.astro';

const forList = [
  'Working professionals with a steady job',
  'Side hustlers ready to make it a real business',
  'Beginners in business, starting from zero',
  'Aspiring real estate investors who need funding',
  'People between jobs who want to build their own',
];
---

<section class="section audience" id="for" aria-labelledby="for-title">
  <div class="wrap">
    <Folio num="01" label="Who it's for" />
    <div class="audience__grid">
      <div class="audience__head">
        <h2 id="for-title" class="display h2" data-lines>
          <span class="line" style="--i:0"><span>For the people</span></span>
          <span class="line" style="--i:1"><span>doing the work</span></span>
          <span class="line" style="--i:2"><span><em>without</em> the capital.</span></span>
        </h2>
        <p class="lede" data-reveal style="--i:3">
          Whether you’re starting out or ready to scale, the day is built to give you the knowledge and the tools to
          make your next move.
        </p>
      </div>

      <ol class="roll" role="list">
        {
          forList.map((item, i) => (
            <li class="roll__item" data-reveal style={`--i:${i}`}>
              <span class="roll__num mono">{String.fromCharCode(65 + i)}</span>
              <span class="roll__text">{item}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="notfor" data-reveal>
      <p class="notfor__label mono">Not for</p>
      <p class="notfor__statement display">
        <span class="strike">another course to collect.</span>
      </p>
      <p class="notfor__body">
        If you’re only casually interested in business, this isn’t your day. It’s for people who will set up the
        business, build the credit and go after the funding.
      </p>
    </div>
  </div>
</section>

<style>
  .audience__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 120px);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .audience__head .lede {
    margin-top: 32px;
  }
  .roll {
    border-top: 1px solid var(--line-strong);
  }
  .roll__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    transition: padding-left 500ms var(--ease-out);
  }
  .roll__item:hover {
    padding-left: 10px;
  }
  .roll__num {
    color: var(--accent);
  }

  .notfor {
    margin-top: clamp(72px, 9vw, 140px);
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 28ch);
    gap: 24px clamp(24px, 4vw, 64px);
    align-items: baseline;
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }
  .notfor__label {
    color: var(--muted);
  }
  .notfor__statement {
    font-size: var(--step-3);
    font-style: italic;
    font-weight: 400;
  }
  .strike {
    position: relative;
    display: inline;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 58%;
    background-size: 100% 3px;
  }
  :global(html.motion) .notfor .strike {
    background-size: 0% 3px;
    transition: background-size 1200ms var(--ease-in-out) 500ms;
  }
  :global(html.motion) .notfor.is-in .strike {
    background-size: 100% 3px;
  }
  .notfor__body {
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .audience__grid {
      grid-template-columns: 1fr;
    }
    .notfor {
      grid-template-columns: 1fr;
    }
  }
</style>
