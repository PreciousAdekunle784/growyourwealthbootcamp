---
import { Image } from 'astro:assets';
import poster from '../assets/img/noelle-studio.jpg';
import { method, primaryCta, vsl } from '../config/site';
import Folio from './Folio.astro';
import Arrow from './Arrow.astro';

const hasVideo = vsl.provider !== null;
const embedSrc =
  vsl.provider === 'vimeo'
    ? `https://player.vimeo.com/video/${vsl.id}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`
    : vsl.provider === 'youtube'
      ? `https://www.youtube-nocookie.com/embed/${vsl.id}?autoplay=1&rel=0&modestbranding=1`
      : (vsl.src ?? '');
---

<section class="section video on-ink" id="watch" aria-labelledby="watch-title">
  <div class="wrap">
    <Folio num="04" label="Watch first" />

    <div class="video__head">
      <h2 id="watch-title" class="display h2" data-lines>
        <span class="line" style="--i:0"><span>Hear it from <em>Noelle</em></span></span>
        <span class="line" style="--i:1"><span>before you give it a day.</span></span>
      </h2>
      <p class="lede" data-reveal style="--i:2">
        {
          hasVideo
            ? 'Press play for the bootcamp presentation, then decide whether the day is right for you.'
            : 'The bootcamp presentation is coming soon. Join the waitlist and you’ll hear when it’s live.'
        }
      </p>
    </div>

    <div class="screen" data-video data-provider={vsl.provider ?? 'none'} data-src={embedSrc} data-title={vsl.title}>
      <div class="screen__frame" data-mask>
        <Image
          src={poster}
          alt={hasVideo ? '' : 'Noelle Randall'}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1400px) 92vw, 1300px"
          class="screen__poster"
        />
        <div class="screen__shade" aria-hidden="true"></div>

        <div class="screen__corner mono" aria-hidden="true">
          <span>GYWB</span><span>{hasVideo ? (vsl.duration ?? 'Presentation') : 'Coming soon'}</span>
        </div>

        {
          hasVideo ? (
            <button class="screen__play" type="button" data-video-play aria-label={`Play video: ${vsl.title}`}>
              <span class="screen__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
                </svg>
              </span>
              <span class="mono">Play the presentation</span>
            </button>
          ) : (
            <a class="screen__play" href="#waitlist">
              <span class="screen__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
                </svg>
              </span>
              <span class="mono">Tell me when it’s live</span>
            </a>
          )
        }
      </div>
    </div>

    <div class="video__after">
      <p class="mono video__after-label" data-reveal>On the day</p>
      <ol role="list" class="video__points">
        {
          method.map((m, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <span class="mono video__num">{String(i + 1).padStart(2, '0')}</span>
              {m.title}
            </li>
          ))
        }
      </ol>
      <a class="btn btn--accent" href={primaryCta.href} data-reveal style="--i:4">
        {primaryCta.label}
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .video__head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: end;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .screen {
    margin-top: clamp(48px, 6vw, 88px);
    position: relative;
  }
  .screen::before {
    /* Registration marks, like a proof sheet */
    content: '';
    position: absolute;
    inset: -14px;
    border: 1px solid var(--line);
    pointer-events: none;
  }
  .screen__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-2);
  }
  .screen__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: saturate(0.9);
  }
  .screen__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(12, 22, 51, 0.82) 0%, rgba(12, 22, 51, 0.25) 55%, rgba(12, 22, 51, 0.05) 100%),
      linear-gradient(0deg, rgba(12, 22, 51, 0.6) 0%, transparent 40%);
  }
  .screen__corner {
    position: absolute;
    top: 20px;
    left: 24px;
    right: 24px;
    display: flex;
    justify-content: space-between;
    color: var(--on-ink);
    font-size: 0.72rem;
  }
  .screen__play {
    position: absolute;
    left: clamp(20px, 4vw, 56px);
    bottom: clamp(20px, 4vw, 56px);
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--on-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .screen__play-icon {
    display: grid;
    place-items: center;
    width: clamp(64px, 8vw, 104px);
    aspect-ratio: 1;
    background: var(--accent-ink);
    color: var(--ink);
    transition:
      transform 600ms var(--ease-out),
      background-color 400ms ease;
  }
  .screen__play-icon svg {
    width: 34%;
    transition: transform 600ms var(--ease-out);
  }
  .screen__play:hover .screen__play-icon,
  .screen__play:focus-visible .screen__play-icon {
    transform: scale(1.06);
    background: var(--paper);
  }
  .screen__play:hover .screen__play-icon svg {
    transform: translateX(2px);
  }
  .screen__play .mono {
    font-size: clamp(0.72rem, 1vw, 0.86rem);
  }
  .screen__frame:hover .screen__poster {
    transform: scale(1.02);
  }
  .screen__poster {
    transition: transform 1600ms var(--ease-out);
  }
  .screen iframe,
  .screen video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .video__after {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    gap: 24px clamp(24px, 4vw, 64px);
    align-items: start;
    margin-top: clamp(56px, 6vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .video__after-label {
    color: var(--muted);
  }
  .video__points {
    display: grid;
    gap: 12px;
    font-size: var(--step-1);
  }
  .video__num {
    color: var(--accent);
    margin-right: 14px;
  }

  @media (max-width: 900px) {
    .video__head,
    .video__after {
      grid-template-columns: 1fr;
    }
    .screen::before {
      inset: -8px;
    }
    .screen__frame {
      aspect-ratio: 4 / 5;
    }
    .screen__poster {
      object-position: 55% 18%;
    }
    .screen__shade {
      background: linear-gradient(0deg, rgba(12, 22, 51, 0.88) 0%, rgba(12, 22, 51, 0.1) 55%);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-video-play]');
    const frame = root.querySelector<HTMLElement>('.screen__frame');
    const src = root.dataset.src;
    if (!button || !frame || !src) return;

    button.addEventListener('click', () => {
      let player: HTMLElement;
      if (root.dataset.provider === 'file') {
        const v = document.createElement('video');
        v.src = src;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        player = v;
      } else {
        const f = document.createElement('iframe');
        f.src = src;
        f.title = root.dataset.title ?? 'Video';
        f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        f.allowFullscreen = true;
        player = f;
      }
      frame.style.aspectRatio = '16 / 9';
      frame.appendChild(player);
      player.focus();
      button.remove();
      frame.querySelector('.screen__corner')?.remove();
    });
  });
</script>
