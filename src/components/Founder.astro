---
import { Image } from 'astro:assets';
import portrait from '../assets/img/noelle-blazer.jpg';
import { founder } from '../config/site';
import Folio from './Folio.astro';
import Arrow from './Arrow.astro';
---

<section class="section founder" id="noelle" aria-labelledby="noelle-title">
  <div class="wrap">
    <Folio num="05" label="Your teacher" />

    <div class="founder__grid">
      <figure class="founder__figure">
        <div class="founder__frame" data-mask data-drift="0.04">
          <Image
            src={portrait}
            alt="Noelle Randall in a cream blazer"
            widths={[360, 540, 644]}
            sizes="(max-width: 900px) 90vw, 38vw"
            class="founder__img"
          />
        </div>
        <figcaption class="mono founder__cap">
          <span>{founder.name}, {founder.postNominals}</span>
          <span>{founder.roles.slice(0, 3).join(' · ')}</span>
        </figcaption>
      </figure>

      <div class="founder__body">
        <h2 id="noelle-title" class="display h2" data-lines>
          <span class="line" style="--i:0"><span>Taught by someone</span></span>
          <span class="line" style="--i:1"><span>who has <em>built it.</em></span></span>
        </h2>

        <div class="prose founder__prose" data-reveal style="--i:2">
          <p>
            Noelle Randall has been an entrepreneur for more than 20 years. She’s a full-time real estate investor, the
            CEO of Noelle Randall Coaching, and the founder and president of FDR Horizon Enterprises, a private real estate
            equity firm.
          </p>
          <p>
            She teaches people from every kind of background who are ready to change their financial position, using the
            same approach she uses in her own businesses.
          </p>
        </div>

        <dl class="figures">
          {
            founder.stats.map((s, i) => (
              <div class="figures__item" data-reveal style={`--i:${i + 3}`}>
                <dt class="mono">{s.label}</dt>
                <dd class="display tabular">{s.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="figures__note mono" data-reveal style="--i:6">As published by Noelle Randall Coaching</p>

        <dl class="credentials" data-reveal style="--i:7">
          <div>
            <dt class="mono">Education</dt>
            <dd>{founder.education.map((e) => `${e.degree}, ${e.school}`).join(' · ')}</dd>
          </div>
          <div>
            <dt class="mono">Author</dt>
            <dd><em>{founder.books[0]}</em> and {founder.books.length - 1} more books</dd>
          </div>
        </dl>

        <a class="link-arrow founder__more" href="/about" data-reveal style="--i:8">Read Noelle’s story <Arrow /></a>
      </div>
    </div>

    <blockquote class="founder__quote" data-reveal>
      <p class="display">{founder.quote}</p>
      <footer class="mono">— {founder.name}</footer>
    </blockquote>
  </div>
</section>

<style>
  .founder__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 120px);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .founder__figure {
    position: relative;
  }
  .founder__frame {
    overflow: hidden;
    aspect-ratio: 4 / 5.6;
    background: var(--paper-3);
  }
  .founder__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .founder__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 16px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.7rem;
  }
  .founder__body {
    padding-top: clamp(0px, 4vw, 64px);
  }
  .founder__prose {
    margin-top: 36px;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted);
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line-strong);
  }
  .figures__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 20px 16px 0 0;
  }
  .figures__item + .figures__item {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .figures dd {
    font-size: var(--step-4);
    line-height: 1;
    font-weight: 400;
  }
  .figures dt {
    color: var(--muted);
    font-size: 0.7rem;
  }
  .figures__note {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.66rem;
  }
  .credentials {
    display: grid;
    gap: 18px;
    margin-top: 40px;
  }
  .credentials > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .credentials dt {
    color: var(--muted);
    font-size: 0.72rem;
    padding-top: 3px;
  }
  .founder__more {
    margin-top: 40px;
  }

  .founder__quote {
    margin: clamp(80px, 10vw, 160px) 0 0;
    padding-left: clamp(0px, 16vw, 240px);
    position: relative;
  }
  .founder__quote p {
    font-size: var(--step-3);
    font-style: italic;
    font-weight: 400;
    line-height: 1.12;
    max-width: 26ch;
  }
  .founder__quote p::before {
    content: '“';
    position: absolute;
    left: clamp(0px, 9vw, 140px);
    margin-top: -0.12em;
    font-size: 2.4em;
    line-height: 1;
    color: var(--accent);
    font-style: normal;
  }
  .founder__quote footer {
    margin-top: 24px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .founder__grid {
      grid-template-columns: 1fr;
    }
    .founder__frame {
      aspect-ratio: 4 / 4.6;
    }
    .figures dd {
      font-size: var(--step-3);
    }
    .credentials > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .founder__quote {
      padding-left: 0;
      padding-top: 0.9em;
    }
    .founder__quote p::before {
      left: 0;
      top: -0.35em;
    }
  }
</style>
