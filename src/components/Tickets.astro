---
import { event, formatDate, isSelling, partners, primaryCta, tiers } from '../config/site';
import Folio from './Folio.astro';
import Arrow from './Arrow.astro';
---

<section class="section tickets" id="tickets" aria-labelledby="tickets-title">
  <div class="wrap">
    <Folio num="07" label="Tickets" />

    <div class="cols cols--end section-head">
      <h2 id="tickets-title" class="c-l display h2" data-lines>
        <span class="line" style="--i:0"><span>Two ways <em>in.</em></span></span>
      </h2>
      <p class="c-r lede" data-reveal style="--i:1">
        {
          isSelling
            ? `Choose your ticket for ${formatDate(event.nextDate)}. You'll select your tier at checkout.`
            : 'Prices are confirmed when the next date is announced. Here’s what each ticket included at the last edition.'
        }
      </p>
    </div>

    <div class="cols tickets__grid section-body">
      {
        tiers.map((t, i) => (
          <article
            class:list={['ticket', { 'ticket--vip on-ink': t.featured }]}
            data-reveal
            style={`--i:${i}`}
            aria-labelledby={`tier-${t.id}`}
          >
            <div class="ticket__main">
              <p class="ticket__meta mono">
                <span>Admit one</span>
                <span>{t.featured ? 'Recommended' : 'Standard'}</span>
              </p>
              <h3 id={`tier-${t.id}`} class="ticket__name display">{t.name}</h3>
              <p class="ticket__summary">{t.summary}</p>

              <ul role="list" class="ticket__list">
                {t.includes.map((item) => (
                  <li>
                    <span class="ticket__tick" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>

            <div class="ticket__stub">
              {isSelling && t.price ? (
                <p class="ticket__price display tabular">{t.price}</p>
              ) : (
                <>
                  <p class="ticket__price ticket__price--tba display">Price with next date</p>
                  <p class="ticket__last mono">Last edition: {t.lastPrice}</p>
                </>
              )}
              <a class:list={['btn', { 'btn--accent': t.featured }]} href={primaryCta.href}>
                {isSelling ? `Choose ${t.name}` : primaryCta.label}
                <Arrow />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="cols"><p class="c-r tickets__policy" data-reveal>
      Event tickets are non-refundable. Ticket holders get replay access after the event, and tickets may be eligible
      for store credit or transfer to a future event. <a href="/refund-policy">Read the full refund policy</a>.
    </p></div>

    <div class="partners cols" data-reveal>
      <div class="c-l partners__intro">
        <p class="mono partners__label">Partner offers for attendees</p>
        <p class="partners__body">
          Attendees get access to offers from companies working in funding, credit, banking and real estate. Some links
          are affiliate links; <a href="/disclaimer#affiliates">see disclosure</a>.
        </p>
      </div>
      <ul role="list" class="c-r partners__list">
        {
          partners.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="sponsored noopener">
                <span class="partners__name">{p.name}</span>
                <span class="partners__field mono">{p.field}</span>
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .tickets__grid {
    align-items: stretch;
  }
  .tickets__grid > .ticket {
    grid-column: span 6;
  }

  .ticket {
    --notch: 14px;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    transition: transform 600ms var(--ease-out);
  }
  .ticket:hover {
    transform: translateY(-6px);
  }
  .ticket--vip {
    background: var(--ink);
    border-color: var(--ink);
  }
  .ticket__main {
    padding: clamp(24px, 3vw, 44px);
  }
  .ticket__meta {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.7rem;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .ticket--vip .ticket__meta span:last-child {
    color: var(--accent);
  }
  .ticket__name {
    font-size: var(--step-3);
    margin-top: 28px;
    line-height: 1;
  }
  .ticket__summary {
    margin-top: 14px;
    color: var(--muted);
    max-width: 34ch;
  }
  .ticket__list {
    margin-top: 28px;
    display: grid;
  }
  .ticket__list li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  .ticket__tick {
    width: 10px;
    height: 10px;
    background: var(--accent);
    transform: translateY(-1px);
  }

  /* Perforated stub with notches */
  .ticket__stub {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(24px, 3vw, 36px) clamp(24px, 3vw, 44px);
    border-top: 2px dashed var(--line-strong);
  }
  .ticket--vip .ticket__stub {
    border-top-color: rgba(244, 239, 230, 0.35);
  }
  .ticket__stub::before,
  .ticket__stub::after {
    content: '';
    position: absolute;
    top: calc(var(--notch) * -1 - 1px);
    width: calc(var(--notch) * 2);
    height: calc(var(--notch) * 2);
    border-radius: 50%;
    background: var(--paper);
  }
  .ticket__stub::before {
    left: calc(var(--notch) * -1 - 1px);
  }
  .ticket__stub::after {
    right: calc(var(--notch) * -1 - 1px);
  }
  .ticket__price {
    font-size: var(--step-4);
    line-height: 1;
  }
  .ticket__price--tba {
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 400;
  }
  .ticket__last {
    color: var(--muted);
    font-size: 0.72rem;
    margin-top: 6px;
    width: 100%;
    order: 0;
  }
  .ticket__stub > div,
  .ticket__stub .btn {
    flex: none;
  }

  .tickets__policy {
    margin-top: 32px;
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 80ch;
  }

  .partners {
    margin-top: clamp(80px, 9vw, 140px);
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }
  .partners__label {
    color: var(--muted);
    margin-bottom: 12px;
  }
  .partners__body {
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 38ch;
  }
  .partners__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--col-gap);
  }
  .partners__list a {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding-left 500ms var(--ease-out);
  }
  .partners__list a:hover,
  .partners__list a:focus-visible {
    padding-left: 8px;
  }
  .partners__name {
    font-weight: 500;
  }
  .partners__field {
    color: var(--muted);
    font-size: 0.66rem;
  }

  @media (max-width: 900px) {
    .tickets__grid > .ticket {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .partners__list {
      grid-template-columns: 1fr;
    }
    .ticket__stub .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
