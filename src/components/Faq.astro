---
import { faqs } from '../config/faq';
import { contact } from '../config/site';
import Folio from './Folio.astro';
---

<section class="section faq" id="questions" aria-labelledby="faq-title">
  <div class="wrap">
    <Folio num="08" label="Questions" />
    <div class="faq__grid">
      <div class="faq__aside">
        <h2 id="faq-title" class="display h2" data-lines>
          <span class="line" style="--i:0"><span>Questions,</span></span>
          <span class="line" style="--i:1"><span><em>answered.</em></span></span>
        </h2>
        <p class="faq__help" data-reveal style="--i:2">
          Still unsure? Talk to the team at
          <a href={`mailto:${contact.email}`}>{contact.email}</a> or
          <a href={contact.phoneHref}>{contact.phoneDisplay}</a>.
        </p>
      </div>

      <div class="faq__list">
        {
          faqs.map((f, i) => (
            <details class="qa" data-reveal style={`--i:${Math.min(i, 5)}`}>
              <summary>
                <span class="qa__num mono">Q.{String(i + 1).padStart(2, '0')}</span>
                <span class="qa__q">{f.q}</span>
                <span class="qa__icon" aria-hidden="true" />
              </summary>
              <div class="qa__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 120px);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .faq__aside {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .faq__help a {
    white-space: nowrap;
  }
  .faq__help {
    margin-top: 32px;
    color: var(--muted);
    max-width: 34ch;
  }
  .faq__list {
    border-top: 1px solid var(--line-strong);
  }
  .qa {
    border-bottom: 1px solid var(--line);
  }
  .qa summary {
    display: grid;
    grid-template-columns: 4rem 1fr 24px;
    gap: 12px;
    align-items: baseline;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa__num {
    color: var(--accent);
  }
  .qa__q {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.15;
    transition: transform 500ms var(--ease-out);
  }
  .qa summary:hover .qa__q {
    transform: translateX(6px);
  }
  .qa__icon {
    position: relative;
    width: 18px;
    height: 18px;
    align-self: center;
  }
  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 500ms var(--ease-out);
  }
  .qa__icon::after {
    transform: rotate(90deg);
  }
  .qa[open] .qa__icon::after {
    transform: rotate(0deg);
  }
  .qa__a {
    padding: 0 40px 28px 4rem;
    margin-left: 12px;
    color: var(--muted);
    max-width: 64ch;
  }
  .qa[open] .qa__a {
    animation: qa-in 600ms var(--ease-out);
  }
  @keyframes qa-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__aside {
      position: static;
    }
    .qa summary {
      grid-template-columns: 3rem 1fr 20px;
    }
    .qa__a {
      padding: 0 0 24px 3rem;
    }
  }
</style>
