---
import { Image } from 'astro:assets';
import badge from '../assets/img/nrc-badge.png';
import { brand, contact, earningsDisclaimer, legalLinks, socials } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="wrap">
    <p class="footer__mark display" aria-hidden="true">Grow Your <em>Wealth</em></p>

    <div class="footer__grid cols">
      <div class="c-l footer__intro">
        <Image src={badge} alt="Noelle Randall Coaching, Winning in Real Estate" width={88} height={88} class="footer__badge" />
        <p>A one-day bootcamp from {brand.parentBrand}: set up the business, build the credit, secure the funding.</p>
      </div>

      <nav class="footer__col footer__col--nav" aria-label="Bootcamp">
        <h2 class="mono footer__h">The bootcamp</h2>
        <ul role="list">
          <li><a href="/#method">The method</a></li>
          <li><a href="/#watch">Watch</a></li>
          <li><a href="/#tickets">Tickets</a></li>
          <li><a href="/#questions">Questions</a></li>
          <li><a href="/#waitlist">Join the waitlist</a></li>
          <li><a href="/about">About Noelle</a></li>
        </ul>
      </nav>

      <div class="footer__col footer__col--support">
        <h2 class="mono footer__h">Support</h2>
        <ul role="list">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.phoneHref}>{contact.phoneDisplay}</a></li>
          <li><a href="/support">Support centre</a></li>
        </ul>
        <address class="footer__addr">
          {contact.mail.map((l) => <span>{l}</span>)}
        </address>
      </div>

      <nav class="footer__col footer__col--social" aria-label="Social">
        <h2 class="mono footer__h">Follow</h2>
        <ul role="list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  {s.label}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <hr class="rule" />

    <div class="footer__legal cols">
      <p class="c-l footer__disclaimer"><strong>Disclaimer:</strong> {earningsDisclaimer}</p>
      <ul role="list" class="c-r footer__legal-links mono">
        <li><a href="/refund-policy">Refund policy</a></li>
        <li><a href="/disclaimer">Disclaimers</a></li>
        <li><a href={legalLinks.terms} target="_blank" rel="noopener">Terms</a></li>
        <li><a href={legalLinks.privacy} target="_blank" rel="noopener">Privacy</a></li>
      </ul>
      <p class="c-full mono footer__copy">© {year} {brand.legalEntity} All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(72px, 9vw, 140px);
    padding-bottom: 40px;
    overflow: hidden;
  }
  .footer > .wrap {
    container-type: inline-size;
  }
  .footer__mark {
    /* "Grow Your Wealth" measures ~6.35× its font size: fill the column exactly. */
    font-size: 15.2cqi;
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin-bottom: clamp(48px, 6vw, 96px);
    margin-left: -0.04em;
  }
  .footer__grid {
    padding-bottom: 56px;
  }
  /* Link columns start on the content axis (column 7). */
  .footer__col--nav {
    grid-column: 7 / span 2;
  }
  .footer__col--support {
    grid-column: 9 / span 3;
  }
  .footer__col--social {
    grid-column: 12 / span 1;
  }
  .footer__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 34ch;
    color: var(--muted);
  }
  .footer__badge {
    width: 72px;
    height: 72px;
    background: var(--paper);
    border-radius: 50%;
    padding: 4px;
  }
  .footer__h {
    color: var(--muted);
    margin-bottom: 18px;
    font-size: 0.74rem;
  }
  .footer ul {
    display: grid;
    gap: 10px;
  }
  .footer a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 480ms var(--ease-out);
  }
  .footer a:hover,
  .footer a:focus-visible {
    background-size: 100% 1px;
  }
  .footer__addr {
    font-style: normal;
    display: grid;
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .footer__legal {
    row-gap: 24px;
    padding-top: 32px;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .footer__disclaimer {
    max-width: 78ch;
  }
  .footer__legal-links {
    display: flex !important;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-content: start;
  }
  .footer__copy {
    grid-column: 1 / -1;
  }
  @media (max-width: 1100px) {
    .footer__grid > .footer__intro {
      grid-column: 1 / -1;
    }
    .footer__col--nav {
      grid-column: 1 / span 4;
    }
    .footer__col--support {
      grid-column: 5 / span 5;
    }
    .footer__col--social {
      grid-column: 10 / span 3;
    }
  }
  @media (max-width: 560px) {
    .footer__col--nav {
      grid-column: 1 / span 6;
    }
    .footer__col--social {
      grid-column: 7 / span 6;
      grid-row: 2;
    }
    .footer__col--support {
      grid-column: 1 / -1;
    }
  }
</style>
