---
import { Image } from 'astro:assets';
import shervonne from '../assets/img/member-shervonne.webp';
import mercedes from '../assets/img/member-mercedes.webp';
import dwayne from '../assets/img/member-dwayne.webp';
import { testimonials } from '../config/site';
import Folio from './Folio.astro';

const photos = { shervonne, mercedes, dwayne } as const;
const [lead, ...rest] = testimonials;
---

<section class="section proof surface-2" id="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <Folio num="06" label="In their words" />

    <div class="proof__head">
      <h2 id="proof-title" class="display h2" data-lines>
        <span class="line" style="--i:0"><span>The people who</span></span>
        <span class="line" style="--i:1"><span>went <em>first.</em></span></span>
      </h2>
      <p class="proof__context" data-reveal style="--i:2">
        Members of Noelle Randall Coaching, in their own words. Individual experiences; results are not typical and are
        not guaranteed. <a href="/disclaimer">Read the disclaimer</a>.
      </p>
    </div>

    <div class="proof__grid">
      <figure class="quote quote--lead" data-reveal>
        <p class="quote__pull mono">{lead.pull}</p>
        <blockquote class="display quote__text">“{lead.quote}”</blockquote>
        <figcaption class="quote__who">
          <Image src={photos[lead.image]} alt="" width={88} height={88} densities={[1, 2]} class="quote__photo" />
          <span>
            <strong>{lead.name}</strong>
            <span class="mono">Noelle Randall Coaching member</span>
          </span>
        </figcaption>
      </figure>

      <div class="proof__rest">
        {
          rest.map((t, i) => (
            <figure class="quote" data-reveal style={`--i:${i + 1}`}>
              <p class="quote__pull mono">{t.pull}</p>
              <blockquote class="quote__text quote__text--sm">“{t.quote}”</blockquote>
              <figcaption class="quote__who">
                <Image src={photos[t.image]} alt="" width={64} height={64} densities={[1, 2]} class="quote__photo" />
                <span>
                  <strong>{t.name}</strong>
                  <span class="mono">Noelle Randall Coaching member</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .proof__head {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: end;
    margin-top: clamp(40px, 5vw, 72px);
  }
  .proof__context {
    color: var(--muted);
    font-size: var(--step--1);
    max-width: 44ch;
  }
  .proof__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 112px);
    margin-top: clamp(56px, 7vw, 104px);
  }
  .quote {
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-strong);
  }
  .quote__pull {
    color: var(--accent);
    margin-bottom: 24px;
  }
  .quote__text {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.25;
    font-weight: 400;
    text-wrap: pretty;
  }
  .quote--lead .quote__text {
    font-size: var(--step-3);
    line-height: 1.12;
  }
  .quote__text--sm {
    font-family: var(--font-text);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .quote__who {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }
  .quote__who strong {
    display: block;
    font-weight: 600;
  }
  .quote__who .mono {
    display: block;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .quote__photo {
    width: 64px;
    height: 64px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 600ms ease;
  }
  .quote--lead .quote__photo {
    width: 88px;
    height: 88px;
  }
  .quote:hover .quote__photo {
    filter: none;
  }
  .proof__rest {
    display: grid;
    gap: clamp(48px, 5vw, 72px);
    align-content: start;
  }

  @media (max-width: 900px) {
    .proof__head,
    .proof__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
