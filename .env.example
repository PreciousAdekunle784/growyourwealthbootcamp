# Copy to .env and fill in. All are optional; the site works without them.

# GoHighLevel checkout step. Used only when event.state is 'open' or 'replay'.
PUBLIC_CHECKOUT_URL=

# Endpoint that receives waitlist sign-ups as JSON (e.g. a GoHighLevel inbound webhook).
# Without it, the form falls back to a pre-filled email to the support address.
PUBLIC_WAITLIST_ENDPOINT=

# Tracking (the old funnel used Meta Pixel 2070714110083227 and Google Ads AW-1010182417).
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
